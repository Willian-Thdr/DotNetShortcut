<Window x:Class="DotNetShortcut.Source.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DotNetShortcut"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

        <Window.Resources>
            <Style x:Key="CurveStyle" TargetType="Label">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Label">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="18">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
    
            <Style x:Key="CurveStyleButton" TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="18"
                                    Padding="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Window.Resources>

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2956d1" Offset="0.2"/>
            <GradientStop Color="#220663" Offset="0.7"/>
        </LinearGradientBrush>
    </Window.Background>

    <Canvas x:Name="canvasRoot" Background="Transparent">
        <Canvas VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent">
            <Label Content="DotNet Shorcut" Canvas.Left="280" Canvas.Top="20" Foreground="Black" 
            FontSize="24pt" HorizontalContentAlignment="Center" Width="240" Background="Transparent"
            Style="{StaticResource CurveStyle}"/>

            <Label Style="{StaticResource CurveStyle}" Content="Escolha o diretório do projeto:" FontSize="12pt"
            Canvas.Top="100" Canvas.Left="50" Width="215"/>

            <TextBox Canvas.Top="100" Canvas.Left="275" FontSize="12pt" Width="250" BorderBrush="Black" BorderThickness="1"
            Background="#e2e2e2" x:Name="ShowDirectory"/>

            <Button Content="Escolher diretório" FontSize="12pt" Canvas.Top="95" Canvas.Left="530" Style="{StaticResource CurveStyleButton}"
            Background="#e2e2e2" Click="ChooseFolder"/>
        </Canvas>
</Canvas>
</Window>
